FROM node:22-alpine
WORKDIR /app
COPY package*.json ./
COPY . .
RUN DATABASE_URL=postgresql://build:build@localhost:5432/astrabi npm install && DATABASE_URL=postgresql://build:build@localhost:5432/astrabi npm run prisma:generate && npm run build && chown -R node:node /app
ENV NODE_ENV=production
USER node
EXPOSE 4000
CMD ["node", "apps/api/dist/index.js"]

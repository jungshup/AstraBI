# Environment configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/astrabi"
NODE_ENV="development"
PORT="4000"
WEB_ORIGIN="http://localhost:3000"
# Replace this with a unique random value of at least 32 bytes before running.
SESSION_SECRET="local-development-secret-change-this-before-use-123456"
ADMIN_EMAIL="admin@astrabi.local"
# Set a unique password of at least 12 characters; never commit your real .env file.
ADMIN_PASSWORD="change-this-admin-password"
